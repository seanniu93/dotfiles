[core]
    excludesfile = ~/.gitignore_global
    editor = vim
[alias]
    # Shorter common commands
    st = status
    ci = commit
    civ = commit --verbose
    co = checkout
    sw = switch

    # More readable git aliases
    # Credit: http://gggritso.com/human-git-aliases

    # Consistent listing
    branches = branch -a
    tags = tag
    stashes = stash list
    remotes = remote -v
    aliases = config --get-regexp ^alias\\.
    worktrees = worktree list

    # Staging
    unstage = reset -q HEAD --
    discard = checkout --
    uncommit = reset --mixed HEAD~
    amend = commit --amend
    nevermind = !git reset --hard HEAD && git clean -d -f
    precommit = diff --cached --diff-algorithm=minimal -w
    unmerged = diff --name-only --diff-filter=U
    untrack = rm --cached

    # Finding
    whenadded = log --diff-filter=A

    # Log formats

    # Standard log with graph
    logg = log --graph --branches --remotes --tags

    # Pretty oneline
    fancy = log --graph \
        --format='%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%aN>%Creset' \
        --abbrev-commit --date=relative

    # Fancy short
    fancys = log -10 --graph \
        --format='%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%aN>%Creset' \
        --abbrev-commit --date=relative

    # Fancy graph
    fancyg = log --graph --branches --remotes --tags \
        --format='%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%aN>%Creset' \
        --abbrev-commit --date=relative

    # Graph
    graph = log --graph --branches --remotes --tags \
        --format='%Cgreen%h %Creset• %<(75,trunc)%s (%aN, %cr) %Cred%d' \
        --date-order

    # Graph short
    graphs = log -10 --graph --branches --remotes --tags \
        --format='%Cgreen%h %Creset• %<(75,trunc)%s (%aN, %cr) %Cred%d' \
        --date-order

[push]
    default = simple
[color]
    ui = auto
[diff]
    tool = vimdiff
[merge]
    tool = vimdiff
[init]
    defaultBranch = main
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    required = true
    clean = git-lfs clean -- %f
